# ------------------------------------------------------------------
# Kopiere diese Datei zu ".env.local" und trage deine Werte ein.
# .env.local wird von Git ignoriert — Secrets landen NIE im Repo.
# Alle Werte hier werden NUR serverseitig gelesen (siehe lib/env.ts).
# ------------------------------------------------------------------

# Welcher KI-Anbieter?
#   mock      = läuft ohne Key (Platzhalter-Render), Standard
#   comfyui   = DEINE eigene KI (SDXL + ControlNet) auf RunPod-GPU
#   modelslab = fertige Interior-API (gemietet)
#   replicate = alternatives Open-Source-Modell
AI_PROVIDER=mock

# Nur nötig, wenn AI_PROVIDER=comfyui. Basis-URL deiner RunPod-Instanz,
# OHNE / am Ende. Findest du im RunPod-Pod unter "Connect" (Port 3000/8188),
# z. B.: https://abc123-3000.proxy.runpod.net
# Nur serverseitig gelesen — landet nie im Browser.
COMFYUI_URL=

# Nur nötig, wenn AI_PROVIDER=modelslab. Serverseitig, nie im Frontend.
# ModelsLab erwartet als Bild eine öffentliche URL (R2/S3), keine Data-URL.
MODELSLAB_API_KEY=

# Nur nötig, wenn AI_PROVIDER=replicate. Serverseitig, nie im Frontend.
REPLICATE_API_TOKEN=

# Stripe im TEST-Modus. Beginnt mit "sk_test_...". Nie den Live-Key hier.
STRIPE_SECRET_KEY=

# Signing Secret des Stripe-Webhooks ("whsec_..."). Nötig, damit bezahlte
# Bestellungen auf "paid" gesetzt werden. Lokal: `stripe listen` zeigt es an.
STRIPE_WEBHOOK_SECRET=

# Supabase (optional). Ohne diese Werte läuft alles wie bisher: Katalog aus
# data/catalog.json, Bestellungen und Render-Kosten nur im Server-Log.
# Projekt-URL und Service-Role-Key: Supabase -> Project Settings -> API.
# Der Service-Role-Key hat Vollzugriff — NUR hier, nie im Frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Basis-URL für Stripe-Redirects (lokal so lassen).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Upstash Redis (REST) für ein Rate-Limit über alle Server-
# Instanzen. Ohne Werte zählt jede Instanz im Arbeitsspeicher.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anteil des Budgets für Logistik/Lieferung (0 bis 0,6). Affiliate: 0.
# Private Label mit Container-Import laut Konzept ~0,35–0,45.
LOGISTICS_SHARE=0

# Harte Kosten-Obergrenze pro Tag (in Euro). Schützt vor Missbrauch.
DAILY_AI_COST_CAP_EUR=5

# Geschätzte Kosten pro Render (in Euro) — für die Cap-Berechnung.
AI_COST_PER_RENDER_EUR=0.05
