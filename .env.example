# ------------------------------------------------------------------
# Kopiere diese Datei zu ".env.local" und trage deine Werte ein.
# .env.local wird von Git ignoriert — Secrets landen NIE im Repo.
# Alle Werte hier werden NUR serverseitig gelesen (siehe lib/env.ts).
# ------------------------------------------------------------------

# Welcher KI-Anbieter?
#   mock      = läuft ohne Key (Platzhalter-Render), Standard
#   modelslab = echte Interior-API (empfohlen für den ersten echten Render)
#   replicate = alternatives Open-Source-Modell
AI_PROVIDER=mock

# Nur nötig, wenn AI_PROVIDER=modelslab. Serverseitig, nie im Frontend.
# ModelsLab erwartet als Bild eine öffentliche URL (R2/S3), keine Data-URL.
MODELSLAB_API_KEY=

# Nur nötig, wenn AI_PROVIDER=replicate. Serverseitig, nie im Frontend.
REPLICATE_API_TOKEN=

# Stripe im TEST-Modus. Beginnt mit "sk_test_...". Nie den Live-Key hier.
STRIPE_SECRET_KEY=

# Basis-URL für Stripe-Redirects (lokal so lassen).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Harte Kosten-Obergrenze pro Tag (in Euro). Schützt vor Missbrauch.
DAILY_AI_COST_CAP_EUR=5

# Geschätzte Kosten pro Render (in Euro) — für die Cap-Berechnung.
AI_COST_PER_RENDER_EUR=0.05
