# ------------------------------------------------------------------
# Kopiere diese Datei zu ".env.local" und trage deine Werte ein.
# .env.local wird von Git ignoriert — Secrets landen NIE im Repo.
# Alle Werte hier werden NUR serverseitig gelesen (siehe lib/env.ts).
# ------------------------------------------------------------------

# Welcher KI-Anbieter?
#   mock      = läuft ohne Key (Platzhalter-Render), Standard
#   replicate = Open-Source-Modelle auf fremder GPU, Abrechnung PRO BILD
#               (günstigster Weg zu echten Renders, keine eigene GPU, keine Lizenz)
#   comfyui   = DEINE eigene KI (SDXL + ControlNet) auf RunPod-GPU (mehr Kontrolle)
#   modelslab = fertige Interior-API (gemietet)
AI_PROVIDER=mock

# Nur nötig, wenn AI_PROVIDER=replicate. Token von replicate.com (Account
# Settings -> API tokens). Serverseitig, nie im Frontend. Replicate rechnet
# pro erzeugtem Bild ab; das Raumfoto geht als Data-URL direkt mit (kein R2/S3).
REPLICATE_API_TOKEN=
# Optional: welches Modell gerendert wird (owner/name). Standard ist ein
# Interior-Redesign-Modell, das die Raumstruktur erhält.
REPLICATE_MODEL=adirik/interior-design
# Phase 2 (objektgenaues Bearbeiten: Möbel tauschen/behalten). Optional,
# nur gebraucht, sobald /api/edit genutzt wird. Owner/Name, austauschbar.
REPLICATE_SEGMENT_MODEL=schananas/grounded_sam
REPLICATE_INPAINT_MODEL=stability-ai/stable-diffusion-inpainting

# Nur nötig, wenn AI_PROVIDER=comfyui. Basis-URL deiner RunPod-Instanz,
# OHNE / am Ende. Findest du im RunPod-Pod unter "Connect" (Port 3000/8188),
# z. B.: https://abc123-3000.proxy.runpod.net
# Nur serverseitig gelesen — landet nie im Browser.
COMFYUI_URL=

# Nur nötig, wenn AI_PROVIDER=modelslab. Serverseitig, nie im Frontend.
# ModelsLab erwartet als Bild eine öffentliche URL (R2/S3), keine Data-URL.
MODELSLAB_API_KEY=

# Stripe im TEST-Modus. Beginnt mit "sk_test_...". Nie den Live-Key hier.
STRIPE_SECRET_KEY=

# Signing Secret des Stripe-Webhooks ("whsec_..."). Nötig, damit bezahlte
# Bestellungen auf "paid" gesetzt werden. Lokal: `stripe listen` zeigt es an.
STRIPE_WEBHOOK_SECRET=

# Supabase (optional). Ohne diese Werte läuft alles wie bisher: Katalog aus
# data/catalog.json, Bestellungen und Render-Kosten nur im Server-Log.
# Projekt-URL und Service-Role-Key: Supabase -> Project Settings -> API.
# Der Service-Role-Key hat Vollzugriff — NUR hier, nie im Frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Basis-URL für Stripe-Redirects (lokal so lassen).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Upstash Redis (REST) für ein Rate-Limit über alle Server-
# Instanzen. Ohne Werte zählt jede Instanz im Arbeitsspeicher.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anteil des Budgets für Logistik/Lieferung (0 bis 0,6). Affiliate: 0.
# Private Label mit Container-Import laut Konzept ~0,35–0,45.
LOGISTICS_SHARE=0

# Harte Kosten-Obergrenze pro Tag (in Euro). Schützt vor Missbrauch.
DAILY_AI_COST_CAP_EUR=5

# Geschätzte Kosten pro Render (in Euro) — für die Cap-Berechnung.
AI_COST_PER_RENDER_EUR=0.05

# Admin-Zugang für den Produkt-Import (/api/admin/import), lange Zufallszeichen.
# CRON_SECRET setzt du bei Vercel für den täglichen Import (Vercel Cron).
ADMIN_TOKEN=
CRON_SECRET=

# Tokens/Feed-URLs der Produktquellen: Namen frei wählbar, sie stehen in
# product_sources.config (authEnv / urlEnv). Beispiel:
# AWIN_FEED_NORDHEIM_URL=https://productdata.awin.com/datafeed/download/apikey/...
#
# Die drei empfohlenen Möbel-Feeds (siehe docs/sql/affiliate-sources.sql):
# AWIN_FEED_OTTO_URL=https://productdata.awin.com/datafeed/download/apikey/DEIN-KEY/...
# AWIN_FEED_HOME24_URL=https://productdata.awin.com/datafeed/download/apikey/DEIN-KEY/...
# DAISYCON_FEED_WESTWING_URL=https://feeds.daisycon.com/...?apikey=DEIN-KEY
